{
  "name": "gaming-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Gaming.Chat desktop and Android private messaging starter",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "android:init": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "firebase": "^12.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "directories": {"output": "release"},
    "appId": "com.gamingchat.app",
    "productName": "Gaming.Chat",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {"target": "nsis", "artifactName": "Gaming.Chat-Setup-${version}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
